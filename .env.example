# ─── CLIENT-SIDE (Vite exposes VITE_* to the browser bundle) ───────────────────
# Maps JS API key — restrict to HTTP referrer: localhost/*, yourdomain.com/*
# APIs enabled: Maps JavaScript API ONLY
VITE_MAPS_PUBLIC_KEY=your_maps_js_api_key_here

# ─── SERVER-SIDE ONLY (never in browser bundle) ─────────────────────────────
# Gemini AI key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Maps server key — restrict to server IP only
# APIs enabled: Geocoding API, Distance Matrix API, Places API
GOOGLE_MAPS_SERVER_KEY=your_server_maps_api_key_here

# ─── SERVER CONFIG ────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:5173
